# Server Configuration
NODE_PORT=5000
PYTHON_HOST=127.0.0.1
PYTHON_PORT=8000
FRONTEND_URL=http://localhost:3000
# Optional semantic firewall analyzer. Without a key, PromptWall uses its
# deterministic offline analyzer and does not make external requests.
LLM_PROVIDER=mock
LLM_MODE=mock
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# To enable Gemini, put these same variables in python-engine/.env:
# LLM_PROVIDER=gemini
# LLM_MODE=live
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash
DATABASE_URL="file:./dev.db"
